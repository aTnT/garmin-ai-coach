# Environment variables for garmin-ai-coach (example only)
# Copy to .env or .env.dev and fill in real values. Do NOT commit real secrets.

# LLM providers (use at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=...
DEEPSEEK_API_KEY=...
MOONSHOT_API_KEY=...

# Observability (optional)
LANGSMITH_API_KEY=lsv2_...

# App mode: development | standard | cost_effective | kimi | kimi_balanced | kimi_cost_effective
# Provider mapping depends on AI mode (see services/ai/ai_settings.py:24 stage_models)
# Defaults:
#   standard -> OpenAI (gpt-5)                     | requires OPENAI_API_KEY
#   development -> Anthropic (claude-4)            | requires ANTHROPIC_API_KEY
#   cost_effective -> Anthropic (claude-3-haiku)   | requires ANTHROPIC_API_KEY
#   kimi -> Moonshot AI (kimi-k2-0905)             | requires MOONSHOT_API_KEY | Best performance
#   kimi_balanced -> Moonshot AI (mixed K2/V1)     | requires MOONSHOT_API_KEY | 15% cost savings
#   kimi_cost_effective -> Moonshot AI (V1 models) | requires MOONSHOT_API_KEY | 26% cost savings
# Tip: If you only set OPENAI_API_KEY, set AI_MODE=standard or update stage_models.
AI_MODE=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
